<Project Sdk="Microsoft.NET.Sdk">

  <!-- Maintainer tool for the translation files (docs/i18n-translation-format.md). Not shipped.
       Run: dotnet run - -project tools/LangTool - - <command> … (see Program.cs or run without arguments). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThumbDock.LangTool</RootNamespace>
    <AssemblyName>LangTool</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shares Core/LangFormat.cs (parser and placeholder rules) with the app. -->
    <ProjectReference Include="..\..\ThumbDock\ThumbDock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThumbDock.Tests" />
  </ItemGroup>

</Project>
