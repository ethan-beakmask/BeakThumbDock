{
  // Sample: one Chrome window per account (9 accounts), slots 1-9.
  // Needs at least 9 slots in the layout (Settings > slot count).
  // Profile folder name: open chrome://version in that account; the last part of "Profile Path" (e.g. Profile 4) is the name.
  // The two flags keep thumbnails live on other virtual desktops; only one of them is needed, both are harmless.
  // Replace the URL with the page to monitor. If several windows get mixed up, add "match": { "process": "chrome.exe", "titleRegex": "part of the page title" }.
  "launch": [
    { "slot": 1, "path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "args": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --profile-directory=\"Profile 1\" https://www.youtube.com/", "delayMs": 2500, "waitSec": 20 },   // account 1
    { "slot": 2, "path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "args": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --profile-directory=\"Profile 2\" https://www.youtube.com/", "delayMs": 2500, "waitSec": 20 },   // account 2
    { "slot": 3, "path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "args": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --profile-directory=\"Profile 4\" https://www.youtube.com/", "delayMs": 2500, "waitSec": 20 },   // account 3
    { "slot": 4, "path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "args": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --profile-directory=\"Profile 5\" https://www.youtube.com/", "delayMs": 2500, "waitSec": 20 },   // account 4
    { "slot": 5, "path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "args": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --profile-directory=\"Profile 6\" https://www.youtube.com/", "delayMs": 2500, "waitSec": 20 },   // account 5
    { "slot": 6, "path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "args": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --profile-directory=\"Profile 7\" https://www.youtube.com/", "delayMs": 2500, "waitSec": 20 },   // account 6
    { "slot": 7, "path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "args": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --profile-directory=\"Profile 8\" https://www.youtube.com/", "delayMs": 2500, "waitSec": 20 },   // account 7
    { "slot": 8, "path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "args": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --profile-directory=\"Profile 10\" https://www.youtube.com/", "delayMs": 2500, "waitSec": 20 }, // account 8
    { "slot": 9, "path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "args": "--disable-features=CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --profile-directory=\"Profile 12\" https://www.youtube.com/", "delayMs": 2500, "waitSec": 20 }  // account 9
  ]
}
